# Copy to .env and fill in. Never commit .env.

# Default provider/model for any role not set below
# providers: anthropic | openai | gemini | mock
LLM_PROVIDER=anthropic
LLM_MODEL=

# Used when the main provider hits a rate limit / quota (e.g. Groq free tier)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Per-role overrides (optional)
EXTRACTOR_PROVIDER=
EXTRACTOR_MODEL=
AGENT_PROVIDER=
AGENT_MODEL=
# Use a different model for the judge so it does not grade its own extraction
JUDGE_PROVIDER=
JUDGE_MODEL=

# Default models when *_MODEL is empty: anthropic claude-sonnet-5-5,
# openai gpt-4.1-mini, gemini gemini-3.8-flash
# Optional Claude effort: low | medium | high | xhigh | max (empty = model default)
ANTHROPIC_EFFORT=

# Call log (metadata only, no message text). LLM_LOG=0 turns it off.
LLM_LOG_PATH=
LLM_LOG=
# With LLM_PROVIDER=mock: YAML file of {prompt substring: reply}
MOCK_LLM_FILE=

# Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For OpenAI-compatible APIs (Groq, Together, Ollama, vLLM). Groq: put the Groq key in
# OPENAI_API_KEY and set OPENAI_BASE_URL=https://api.groq.com/openai/v1 (GROQ_API_KEY is not read)
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Web search for scheme discovery: tavily | brave | serpapi | google_cse
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# v0.8 roles: planner = reasoning (needs analysis, search plan, reflection, which question to ask)
PLANNER_PROVIDER=
PLANNER_MODEL=
# Fallback chains, tried in order on rate limit / quota / overload / offline: provider:model,provider:model
PLANNER_FALLBACKS=
EXTRACTOR_FALLBACKS=
AGENT_FALLBACKS=
# Local models via Ollama (no quota). Default http://localhost:11434/v1
LOCAL_BASE_URL=

# Optional WhatsApp adapter; disabled until explicitly configured.
YOJANA_WAHA_ENABLED=false
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
YOJANA_WAHA_WEBHOOK_SECRET=
# Use a separate private runtime database when experimenting with ingestion.
SCHEME_DB=

# V2.4 case database (separate from the public SQLite scheme catalog).
# See deploy/.env.example and DEPLOYMENT.md for production runtime settings.
DEPLOYMENT_MODE=development
DATABASE_URL=
SESSION_AUTH_REQUIRED=false
SESSION_SIGNING_KEY=
APP_ORIGINS=
CASE_RETENTION_DAYS=30
CASE_HISTORY_LIMIT=40
WAHA_HMAC_KEY=
LLM_TIMEOUT_SECONDS=30
SSE_WINDOW_SECONDS=25

# V2.5 speech and WhatsApp-to-browser handoff; server only, never Vercel/public assets.
PUBLIC_FRONTEND_ORIGIN=
SARVAM_API_KEY=
# Optional bounded assessment question budget (1–12).
ASSESSMENT_QUESTION_BUDGET=7
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_ENABLED=false
SARVAM_STT_MODEL=saaras:v3
# Speech-to-text provider: local (self-hosted stt_service, recommended), sarvam (opt-in), off.
# Unset = legacy: sarvam only when SARVAM_STT_ENABLED=true. local never falls back to Sarvam.
STT_PROVIDER=
LOCAL_STT_URL=
LOCAL_STT_TOKEN=
LOCAL_STT_TIMEOUT_SECONDS=30
# --- yojana-stt service only (python -m stt_service; see docs/LOCAL_STT.md) ---
LOCAL_STT_MODEL=small
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_BEAM_SIZE=1
LOCAL_STT_ENGINE=faster-whisper
STT_MODEL_DIR=/models
STT_CPU_THREADS=2
STT_CONCURRENCY=1
STT_QUEUE_WAIT_SECONDS=20
STT_ALLOW_DOWNLOAD=false
# Extra origins WAHA may put in media.url (its own WAHA_BASE_URL, e.g. http://localhost:3000) when that
# differs from the private WAHA_BASE_URL above. Audio is still fetched only from WAHA_BASE_URL.
WAHA_MEDIA_ORIGINS=
# WhatsApp menus (docs/WHATSAPP_MENUS.md). true = send menus as WAHA interactive lists (POST /api/sendList,
# NOWEB), falling back to the numbered text menu on any error. Keep false until a real phone shows the list.
WAHA_INTERACTIVE_LISTS=false
# Read a spoken number back before using it when local STT is unsure (confidence below this) or the
# note is in one of these languages (local STT is weakest in Marathi). Empty list = confidence only.
VOICE_CONFIRM_BELOW=0.75
VOICE_CONFIRM_LANGUAGES=mr
# Browser voice (docs/BROWSER_VOICE.md). TTS_PROVIDER: sarvam | browser | off (unset: sarvam when
# SARVAM_API_KEY is set, else browser). BROWSER_STT_MODE: server | device | auto (unset: server when
# STT_PROVIDER=local is configured, so recordings stay on our servers).
TTS_PROVIDER=
BROWSER_STT_MODE=

# Scheme catalog in PostgreSQL (store/pg.py). Empty = SQLite in data/schemes.db. Not DATABASE_URL:
# that is the case database above. Both may point at the same Postgres server (tables do not overlap).
# Hosted example (Neon): postgresql://user:password@host/dbname?sslmode=require
SCHEME_DATABASE_URL=
# Seconds the web process keeps the Postgres catalog in memory (worker additions appear within this). Default 60.
SCHEME_CATALOG_TTL_SECONDS=
# Opt-in Postgres scheme-store tests (tests/test_pg_store.py). The database name must end in _test:
# it is emptied on every run.
TEST_DATABASE_URL=

# Agent roles (agents/, saathi/orchestrator.py). Each falls back to the older role when unset:
# READER_* -> EXTRACTOR_*, SCOUT_* -> PLANNER_*, VERIFIER_* -> JUDGE_*. The Replier uses AGENT_*.
# Fast providers for the roles a person waits on (reader, agent); a Verifier on a different vendor
# from the Extractor. Example: READER_PROVIDER=openai with Groq, READER_FALLBACKS=openai:openai/gpt-oss-20b,gemini:
READER_PROVIDER=
READER_MODEL=
READER_FALLBACKS=
SCOUT_PROVIDER=
SCOUT_MODEL=
SCOUT_FALLBACKS=
VERIFIER_PROVIDER=
VERIFIER_MODEL=
VERIFIER_FALLBACKS=
# Seconds one model call may take per role (defaults: reader 15, agent 25, scout 30, extractor 120,
# verifier 45). Local models get 15 s more to load. Example: READER_TIMEOUT=20
READER_TIMEOUT=
EXTRACTOR_TIMEOUT=
# Daily caps for cloud models (local models are never capped). 0 = no cap.
BUDGET_TOKENS_GAP=
BUDGET_TOKENS_BATCH=
# Live web searches per day across all gap-fills (SerpAPI free plan: 250 a month). Default 8.
BUDGET_SEARCHES_DAY=
# 0 = skip the Verifier agent (flagged rules are kept unchanged). Default on.
VERIFY_RULES=
# Seconds the worker waits before sending a follow-up, so several new pages make one message. Default 20.
NOTIFY_DELAY=
# The worker never messages people through WAHA unless this is true (and YOJANA_WAHA_ENABLED=true).
WORKER_OUTBOUND_ENABLED=false
# Worker heartbeat for the container health check (default $HOME/worker.heartbeat; stale after 900 s).
WORKER_HEARTBEAT=
WORKER_HEARTBEAT_MAX_AGE=
