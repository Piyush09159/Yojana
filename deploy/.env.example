# EasyPanel runtime secrets only. Copy into its Environment panel; never Vercel.
# AgentX live-demo checklist: docs/AGENTX_DEMO.md. Keep the existing signing key stable.
# Groq uses the existing OpenAI-compatible adapter; select an account-available model.
# Tap-to-interrupt needs no extra service or environment variable.
DEPLOYMENT_MODE=production
DATABASE_URL=
SESSION_AUTH_REQUIRED=true
SESSION_SIGNING_KEY=
APP_ORIGINS=
CASE_RETENTION_DAYS=30
CASE_HISTORY_LIMIT=40
MAX_ACTIVE_CASES=2000
REQUESTS_PER_MINUTE=120
SSE_WINDOW_SECONDS=25
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_LOG=0
SEARCH_PROVIDER=
YOJANA_WAHA_ENABLED=false
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_HMAC_KEY=
WAHA_WEBHOOK_URL=
# Legacy URL-secret webhook is disabled in production. Do not configure it.
YOJANA_WAHA_WEBHOOK_SECRET=

# Compose-only settings; not needed for the separate EasyPanel PostgreSQL service.
POSTGRES_PASSWORD=
# Set to a reviewed immutable official image reference, e.g. devlikeapro/waha@sha256:...
WAHA_IMAGE=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# V2.5 runtime-only configuration. Actual speech coverage remains unverified.
PUBLIC_FRONTEND_ORIGIN=
SARVAM_API_KEY=
# Optional bounded assessment question budget (1–12).
ASSESSMENT_QUESTION_BUDGET=7
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_ENABLED=false
SARVAM_STT_MODEL=saaras:v3
# Backend Docker image includes ffmpeg. Optional local executable override:
FFMPEG_BINARY=ffmpeg
# WAHA media URL must match WAHA_BASE_URL exactly; redirects/S3 URLs are rejected.
# Activation: YOJANA / YOJNA / योजना. Named Chat / Call only; no START/numeric menu.

# Optional opt-in scheme alerts (no SMS carrier included).
# UPDATES from a WhatsApp chat enables alerts, UPDATES OFF disables them.
# Run reviewed campaign CLI manually with scripts/send_scheme_updates.py.
# Do not add telephone numbers from LIDs, and never send unapproved schemes.
# For WAHA voice-note media delivery, configure these on the WAHA service:
# WAHA_EVENTS_DOWNLOAD_MEDIA=true
# WAHA_EVENTS_DOWNLOAD_MEDIA_MIMETYPES=audio
# WHATSAPP_FILES_LIFETIME=180
# WAHA's event media.url must point to the same origin configured in API WAHA_BASE_URL.

# Application-guide PDF service on Render (docs/PDF_SERVICE.md). Token must match PDF_SERVICE_TOKENS there.
PDF_SERVICE_URL=
PDF_SERVICE_TOKEN=
PDF_SERVICE_TIMEOUT=60
PDF_SERVICE_RETRIES=2

# ---------- Confirmed WhatsApp results, PDF guide, follow-up calls (docs/RESULT_DELIVERY.md) ----------
# Enable in this order, each after the previous one is verified on a test phone. All default false.
# 1. Show recorded facts for PROCEED / CHANGE / HELP before any scheme is sent on WhatsApp.
SCHEME_REVIEW_CONFIRMATION_ENABLED=false
# 2. After PROCEED, send one bundled guide (WAHA /api/sendFile). Needs PDF_SERVICE_URL/TOKEN above.
WHATSAPP_PDF_SEND_ENABLED=false
PDF_DELIVERY_MAX_ATTEMPTS=
WHATSAPP_PDF_MAX_BYTES=
# 3. One consented automated follow-up call (Bolna) after the guide was accepted by WAHA.
#    Only WhatsApp phone JIDs (<digits>@c.us) qualify; @lid chats are never called.
#    Check India service-call consent, DND and quiet-hour rules with legal/compliance first.
BOLNA_FOLLOWUP_ENABLED=false
BOLNA_API_KEY=
BOLNA_FOLLOWUP_AGENT_ID=
# Min 24 random characters; also used in the Bolna webhook URL path. Rotate if ever exposed.
BOLNA_WEBHOOK_SECRET=
BOLNA_FROM_PHONE_NUMBER=
BOLNA_FOLLOWUP_DELAY_SECONDS=
BOLNA_ALLOWED_COUNTRY_CODES=
# IST window with no calls. Default 21:00-09:00.
CALL_QUIET_HOURS=
# Browser verification calls (POST /api/bolna/verify), a separate agent. Default off.
BOLNA_VERIFICATION_ENABLED=false
BOLNA_AGENT_ID=
# Delivery runner: inside the API by default. Set false when running `python -m web.delivery_worker` separately.
DELIVERY_WORKER_ENABLED=
DELIVERY_POLL_SECONDS=
